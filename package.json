{
  "name": "trustledger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TrustLedger — public donation transparency and resource accountability system",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev --port 8787 --local",
    "schema:generate": "node scripts/generate-schema.mjs",
    "predev": "npm run schema:generate",
    "prebuild": "npm run schema:generate",
    "preworker:dev": "npm run schema:generate",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json",
    "pretypecheck": "npm run schema:generate",
    "db:schema": "wrangler d1 execute trustledger --local --file=./db/schema.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1"
  },
  "dependencies": {
    "hono": "^4.9.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "wrangler": "^4.35.0"
  }
}
